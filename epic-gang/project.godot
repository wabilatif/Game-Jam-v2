; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Epic-gang"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Localization="*res://scripts/Localization.gd"
GameManager="*res://scripts/GameManager.gd"
NoiseManager="*res://scripts/NoiseManager.gd"
PowerManager="*res://scripts/PowerManager.gd"
AudioManager="*res://scripts/AudioManager.gd"
EffectsManager="*res://scripts/EffectsManager.gd"
UIManager="*res://scripts/UIManager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Epic-gang"

[internationalization]

locale/fallback="fr"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
