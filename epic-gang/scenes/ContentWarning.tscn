[node name="Content" type="Label" parent="Margin/Scroll/Layout"]
layout_mode = 2
theme_type_variation = &"FieldValueLabel"
theme_override_constants/line_spacing = 8
text = "Une ambiance angoissante et des sons soudains.\nDes lumières clignotantes et des effets visuels intenses.\nDes mouvements de caméra pouvant provoquer un inconfort."
autowrap_mode = 3

[node name="Advice" type="Label" parent="Margin/Scroll/Layout"]
layout_mode = 2
theme_type_variation = &"FieldValueLabel"
text = "Si vous êtes sensible à ces effets, évitez de jouer.\nEn cas d'inconfort, arrêtez la partie."
autowrap_mode = 3

[node name="BottomSpace" type="Control" parent="Margin/Scroll/Layout"]
layout_mode = 2
